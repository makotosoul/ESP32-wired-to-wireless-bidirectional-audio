# FreeRTOS tick for stable 1 ms delays.
CONFIG_FREERTOS_HZ=1000

# UAC: speaker STEREO + mic MONO, both at 48 kHz.
# ONLY difference vs Node_A_Spk_Mic_Test_idf (which works at 44.1 kHz):
#   CONFIG_UAC_SAMPLE_RATE: 44100 -> 48000
# Channels, intervals, task cores are all unchanged. This isolates
# "sample rate" as the variable.
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_MIC_INTERVAL_MS=10
# 10 ms @ 48 kHz stereo 16-bit speaker => 1920 B per uac_output_cb call.
# 10 ms @ 48 kHz mono   16-bit  mic    => 960  B per uac_input_cb  call.

# Pin USB / UAC worker tasks to Core 1; leave Core 0 for WiFi + ESP-NOW.
CONFIG_UAC_TINYUSB_TASK_CORE=1
CONFIG_UAC_SPK_TASK_CORE=1
CONFIG_UAC_MIC_TASK_CORE=1
CONFIG_ESP_WIFI_TASK_CORE_ID=0

# Bursty ESP-NOW (one 240 B speaker packet every ~5 ms now at 48 kHz stereo).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
